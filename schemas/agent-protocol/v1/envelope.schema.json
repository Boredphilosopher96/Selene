{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://selene.dev/schemas/agent-protocol/v1/envelope.schema.json",
  "title": "Selene Agent Protocol v1 Envelope",
  "type": "object",
  "additionalProperties": true,
  "required": ["protocolVersion", "kind", "messageId", "sentAt"],
  "properties": {
    "protocolVersion": { "const": "1.0" },
    "kind": { "enum": ["hello", "request", "event", "cancel", "error"] },
    "messageId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "sentAt": { "type": "string", "format": "date-time" },
    "requestId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "capabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,127}$" } },
    "operation": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,127}$" },
    "input": { "type": "object" },
    "event": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,127}$" },
    "output": { "type": "object" },
    "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
    "message": { "type": "string", "maxLength": 4096 },
    "retryable": { "type": "boolean" }
  },
  "allOf": [
    { "if": { "properties": { "kind": { "const": "hello" } } }, "then": { "required": ["capabilities"] } },
    { "if": { "properties": { "kind": { "const": "request" } } }, "then": { "required": ["requestId", "operation", "input"] } },
    { "if": { "properties": { "kind": { "const": "event" } } }, "then": { "required": ["requestId", "event"] } },
    { "if": { "properties": { "kind": { "const": "cancel" } } }, "then": { "required": ["requestId"] } },
    { "if": { "properties": { "kind": { "const": "error" } } }, "then": { "required": ["code", "message"] } }
  ]
}
