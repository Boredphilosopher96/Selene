{
  "name": "selene",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Boredphilosopher96/Selene.git"
  },
  "bugs": {
    "url": "https://github.com/Boredphilosopher96/Selene/issues"
  },
  "homepage": "https://github.com/Boredphilosopher96/Selene#readme",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "vite": "7.3.5",
    "@vitest/expect": "3.2.6",
    "@vitest/mocker": "3.2.6",
    "@vitest/pretty-format": "3.2.6",
    "@vitest/runner": "3.2.6",
    "@vitest/snapshot": "3.2.6",
    "@vitest/spy": "3.2.6",
    "@vitest/utils": "3.2.6"
  },
  "trustedDependencies": [
    "electron"
  ],
  "scripts": {
    "postinstall": "bun scripts/ensure-electron.mjs",
    "dev": "bun run --cwd apps/web dev",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:desktop": "bun run --cwd apps/desktop dev",
    "desktop:runtime:verify": "bun scripts/ensure-electron.mjs",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "bun run --filter '*' typecheck",
    "build": "bun run --filter './packages/*' build && bun run --filter './apps/*' build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "storybook": "XDG_CONFIG_HOME=.cache storybook dev --config-dir packages/ui/.storybook -p 6006 --ci",
    "build-storybook": "XDG_CONFIG_HOME=.cache storybook build --config-dir packages/ui/.storybook --output-dir storybook-static",
    "prepare-pages": "bun scripts/prepare-pages.mjs",
    "sbom": "bun scripts/generate-sbom.mjs",
    "release:dry-run": "bun scripts/release-dry-run.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "2.29.8",
    "@eslint/js": "9.36.0",
    "@playwright/test": "1.55.1",
    "@storybook/addon-a11y": "9.1.19",
    "@storybook/react-vite": "9.1.19",
    "@types/bun": "1.3.14",
    "@types/node": "24.13.3",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.36.0",
    "globals": "16.3.0",
    "prettier": "3.6.2",
    "storybook": "9.1.19",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.1",
    "vite": "7.3.5",
    "vitest": "3.2.6"
  }
}
