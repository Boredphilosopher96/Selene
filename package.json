{
  "name": "selene",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Boredphilosopher96/Selene.git"
  },
  "bugs": {
    "url": "https://github.com/Boredphilosopher96/Selene/issues"
  },
  "homepage": "https://github.com/Boredphilosopher96/Selene#readme",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "vite": "8.1.5",
    "@vitest/expect": "4.1.10",
    "@vitest/mocker": "4.1.10",
    "@vitest/pretty-format": "4.1.10",
    "@vitest/runner": "4.1.10",
    "@vitest/snapshot": "4.1.10",
    "@vitest/spy": "4.1.10",
    "@vitest/utils": "4.1.10"
  },
  "trustedDependencies": [
    "electron"
  ],
  "scripts": {
    "postinstall": "bun scripts/ensure-electron.mjs",
    "dev": "bun run --cwd apps/web dev",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:desktop": "bun run --cwd apps/desktop dev",
    "desktop:runtime:verify": "bun scripts/ensure-electron.mjs",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "oxlint --deny-warnings",
    "typecheck": "bun run --filter '*' typecheck",
    "build": "bun run --filter './packages/*' build && bun run --filter './apps/*' build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:startup": "bun run build && playwright test --config playwright.startup.config.ts",
    "test:a11y": "bun run build && playwright test --config playwright.a11y.config.ts",
    "test:a11y:stress": "for attempt in 1 2 3 4 5; do bun run test:a11y || exit 1; done",
    "storybook": "XDG_CONFIG_HOME=.cache storybook dev --config-dir packages/ui/.storybook -p 6006 --ci",
    "build-storybook": "XDG_CONFIG_HOME=.cache storybook build --config-dir packages/ui/.storybook --output-dir storybook-static",
    "check:emitted-size": "node scripts/check-emitted-size.mjs",
    "audit:ui": "bun run --filter @selene/ui typecheck && vitest run packages/ui/src/public-api.contract.test.ts && bun run --filter @selene/ui build && node scripts/audit-ui-public-api.mjs",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "prepare-pages": "bun scripts/prepare-pages.mjs",
    "sbom": "bun scripts/generate-sbom.mjs",
    "check:outdated": "bun scripts/check-outdated.mjs",
    "release:dry-run": "bun scripts/release-dry-run.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@playwright/test": "1.61.1",
    "@storybook/addon-a11y": "10.5.3",
    "@storybook/react-vite": "10.5.3",
    "@types/bun": "1.3.14",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "axe-core": "4.12.1",
    "oxlint": "1.75.0",
    "prettier": "3.9.6",
    "storybook": "10.5.3",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
