{
  "name": "selene",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:desktop": "bun run --cwd apps/desktop dev",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "bun run --filter '*' typecheck",
    "build": "bun run --filter './packages/*' build && bun run --filter './apps/*' build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "storybook": "XDG_CONFIG_HOME=.cache storybook dev --config-dir packages/ui/.storybook -p 6006 --ci",
    "build-storybook": "XDG_CONFIG_HOME=.cache storybook build --config-dir packages/ui/.storybook --output-dir storybook-static",
    "prepare-pages": "bun scripts/prepare-pages.mjs",
    "sbom": "bun scripts/generate-sbom.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@eslint/js": "9.36.0",
    "@playwright/test": "1.55.1",
    "@storybook/addon-a11y": "9.1.8",
    "@storybook/react-vite": "9.1.8",
    "@types/bun": "1.3.0",
    "@types/node": "24.5.2",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "eslint": "9.36.0",
    "globals": "16.3.0",
    "prettier": "3.6.2",
    "storybook": "9.1.8",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.1",
    "vite": "7.1.7",
    "vitest": "3.2.4"
  }
}
