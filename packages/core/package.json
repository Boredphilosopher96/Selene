{
  "name": "@selene/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@selene/project-schema": "workspace:*",
    "zod": "4.4.3"
  },
  "scripts": {
    "build": "bun run --cwd ../project-schema build && tsc -p tsconfig.json",
    "typecheck": "bun run --cwd ../project-schema build && tsc --noEmit -p tsconfig.json",
    "check:public-api": "bun run build && bun scripts/assert-public-api.mjs"
  }
}
