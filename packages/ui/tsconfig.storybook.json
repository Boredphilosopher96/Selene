{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "../..",
    "jsx": "react-jsx",
    "paths": {
      "@selene/core": ["../core/src/index.ts"],
      "@selene/core/prototype": ["../core/src/prototype.ts"],
      "@selene/ui": ["./src/index.ts"],
      "@selene/ui/workspace": ["./src/workspace.ts"],
      "@selene/ui/prototype": ["./src/prototype.ts"],
      "@selene/ui/prototype-flow": ["./src/prototype-flow.ts"],
      "@selene/ui/prototype-runtime": ["./src/prototype-runtime.ts"],
      "@selene/ui/designer-workspace": ["./src/designer-workspace-entry.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "../../apps/desktop/src/shared/**/*.ts",
    "../../apps/desktop/src/renderer/src/cockpit/**/*.ts",
    "../../apps/desktop/src/renderer/src/cockpit/**/*.tsx"
  ]
}
