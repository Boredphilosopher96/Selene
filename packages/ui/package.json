{
  "name": "@selene/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./workspace": {
      "types": "./dist/workspace.d.ts",
      "import": "./dist/workspace.js"
    },
    "./prototype": {
      "types": "./dist/prototype.d.ts",
      "import": "./dist/prototype.js"
    },
    "./prototype-flow": {
      "types": "./dist/prototype-flow.d.ts",
      "import": "./dist/prototype-flow.js"
    },
    "./prototype-runtime": {
      "types": "./dist/prototype-runtime.d.ts",
      "import": "./dist/prototype-runtime.js"
    },
    "./designer-workspace": {
      "types": "./dist/designer-workspace-entry.d.ts",
      "import": "./dist/designer-workspace-entry.js"
    },
    "./designer-workspace.css": "./dist/designer-workspace.css"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@selene/core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "scripts": {
    "build": "bun run --cwd ../core build && tsc --build --clean tsconfig.json && tsc -p tsconfig.build.json && bun scripts/copy-css-assets.mjs",
    "copy:css-assets": "bun scripts/copy-css-assets.mjs",
    "typecheck": "bun run --cwd ../core build && tsc -p tsconfig.storybook.json"
  }
}
