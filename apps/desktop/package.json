{
  "name": "@selene/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Selene's local-first AI design-to-React desktop workspace.",
  "author": {
    "name": "Sumukh Nitundila",
    "email": "Boredphilosopher96@users.noreply.github.com"
  },
  "homepage": "https://github.com/Boredphilosopher96/Selene",
  "desktopName": "Selene",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit -p tsconfig.json && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:e2e": "bun run --cwd ../../packages/core build && bun run build && playwright test -c playwright.config.ts",
    "preview": "electron-vite preview"
  },
  "dependencies": {
    "@selene/agent-sdk": "workspace:*",
    "@selene/config": "workspace:*",
    "@selene/core": "workspace:*",
    "@selene/design-inputs": "workspace:*",
    "@selene/host-runtime": "workspace:*",
    "@selene/identity-runtime": "workspace:*",
    "@selene/ui": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "8.1.5"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-vite": "5.0.0"
  }
}
